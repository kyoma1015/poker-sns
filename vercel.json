export default {
  fetch(request) {
    const url = new URL(request.url)

    return new Response(
      `OG function alive\n\ntype=${url.searchParams.get('type')}\nid=${url.searchParams.get('id')}`,
      {
        status: 200,
        headers: {
          'Content-Type': 'text/plain; charset=utf-8',
        },
      },
    )
  },
}